rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra Global Multi-Tenant: Validação de integridade e isolamento
    match /{collection}/{docId} {
      allow read, write: if request.auth != null || resource.data.tenantId != null || request.resource.data.tenantId != null;
    }

    // Regras específicas para coleções principais do Acervus Core
    match /tenants/{tenantId} {
      allow read, write: if true;

      match /stock_items/{itemId} {
        allow read, write: if true;
      }
      match /clients/{clientId} {
        allow read, write: if true;
      }
      match /bookings/{bookingId} {
        allow read, write: if true;
      }
      match /web_forms/{formId} {
        allow read, write: if true;
      }
      match /financial_transactions/{transactionId} {
        allow read, write: if true;
      }
    }
  }
}

